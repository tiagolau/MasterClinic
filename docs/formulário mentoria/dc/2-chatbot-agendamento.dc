      "sourceBlockId": null,
      "options": {
        "messages": [
          {
            "name": "send-text-message",
            "group": "messages",
            "stepId": "dc90701f-b2f7-4876-8fc9-17846a75a1aa",
            "options": {
              "text": "Oi {leadFirstName}! 👋 Aqui é a equipe do Dr. Wilton Vargas.\n\nVi que você preencheu o formulário da Mentoria Dr. Wilton Vargas — que bom te ver por aqui!\n\nPosso te explicar rapidinho como funciona e já deixar sua conversa com o Dr. Wilton agendada?",
              "buttons": [],
              "breakMessages": true,
              "breakMessagesIntervalInSeconds": 2
            }
          }
        ],
        "platform": "",
        "provider": "",
        "timezone": "",
        "contactId": "",
        "instanceId": "",
        "nextBlockId": "af00e0c1-fbc2-4e5d-92b8-71cc8a7f74ce",
        "isAnnotation": false,
        "scheduledDate": "",
