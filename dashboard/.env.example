SECRET_KEY=gere-com--openssl rand -hex 32
POSTGRES_PASSWORD=gere-com--openssl rand -hex 16

# === Meta Ads ===
FB_ACCESS_TOKEN=EAAG...                          # escopo ads_read (o token global já serve)
# META_AD_ACCOUNTS=act_146238145960571,act_256216457271970

# === Clinicorp (agenda/comparecimento — fase 2) ===
CLINICORP_API_USER=masterclinic
